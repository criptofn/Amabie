# KNOWN_RUNNER_RELEASES pins the mocha double by canonical CONTENT HASH
# (treeSha256 over the exact bytes). git's eol normalization (core.autocrlf
# on a Windows checkout) would silently change those bytes and miss the pin —
# which fails CLOSED, but turns every offline test on that host into a
# mystery. Force LF so checkout bytes == hash bytes on every platform.
apps/cli/test/fixtures/mocha-double/** text eol=lf

# The published contract is diffed field-by-field against contract.ts output;
# LF keeps the committed artifact byte-identical on every platform.
schemas/evidence.schema.json text eol=lf

# Review manifests are recomputed field-by-field by
# support/known-runners-manifest.test.ts; the digests are line-anchored, so
# an autocrlf checkout (adding \r before the sha) would break parsing. Force
# LF so the committed reviewed-bytes record survives every platform.
packages/support/test/fixtures/runner-manifests/** text eol=lf

# Keep captured validation logs and source snapshots byte-for-byte for evidence hashes.
/tooling/benchmark/results/session-evidence/post-v15-validation-2026-09-27/** -text

# Preserve exact bytes for the post-v1.5 pilot preflight and its SHA-256 manifest.
/tooling/benchmark/results/session-evidence/post-v15-pilot-20260927/** -text

# Retain captured evidence while keeping generated results collapsed in GitHub reviews.
/tooling/benchmark/results/** linguist-generated
