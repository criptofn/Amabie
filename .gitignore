.claude/settings.local.json

# Amabie run workspaces (disposable, never committed)
.amabie-runs/
# Project-local Amabie settings and trust state (machine-local)
.amabie/
# Existing projects may still have run evidence from the Canary CLI.
.canary-runs/
# Existing projects may still have local Canary settings and trust state.
.canary/

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Night Runner scratch — per-worktree, NOT shared; durable evidence must be
# exported to docs/night-evidence/ before DONE (docs/night-evidence/README.md)
.night-run/

# Hook-local state (HoldTheGoblin event/audit logs) — machine-local, never tracked
.holdthegoblin/

# M1 packaging scratch (staging manifest + bundle + packed .tgz) — the artifact
# of record is proven by tooling/probes/cleanroom-packed-artifact.mjs, not committed
/pack/

# Workspace-local toolchains provisioned by tooling/toolchains.mjs (Go, Rust).
# They exist so Rust and Go can be VALIDATED without administrator rights and
# without touching global machine state; they are hundreds of MB and
# machine-specific, so they are never committed.
# Re-provision with: node tooling/toolchains.mjs all
/_toolchains/

# Local secrets and credentials
.env
.env.*
!.env.example
.envrc
.npmrc
*.pem
*.key
*.p12
*.pfx
