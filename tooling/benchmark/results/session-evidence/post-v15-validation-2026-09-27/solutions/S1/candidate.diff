+
+    @Test
+    void twoKeysSharingOneValueAreStillAmbiguous() {
+        String shared = "same-object";
+        Map<String, String> aliased = new LinkedHashMap<>();
+        aliased.put("abcd1234", shared);
+        aliased.put("abcd5678", shared);
+
+        assertNull(IdLookup.uniquePrefix(aliased, "abcd", 4));
+        assertEquals(shared, IdLookup.uniquePrefix(aliased, "abcd1234", 4));
+        assertEquals(shared, IdLookup.uniquePrefix(aliased, "abcd5678", 4));
+    }
+
+    @Test
+    void equalButDistinctValuesAreAmbiguous() {
+        Map<String, String> equalValues = new LinkedHashMap<>();
+        equalValues.put("abcd1234", new String("same"));
+        equalValues.put("abcd5678", new String("same"));
+
+        assertNull(IdLookup.uniquePrefix(equalValues, "abcd", 4));
