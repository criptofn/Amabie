+// Cut a pytest summary field at the first ` - ` separator that is not inside a
+// `[parametrization]` bracket. If none is found (e.g. an unbalanced `[` inside
+// a param value keeps the depth open), the whole field is kept: that can split
+// one test into run-specific ids, which only ever makes the delta report MORE
+// new failures — parse gaps never make the gate lenient.
+function stripPytestRepr(field: string): string {
+  let depth = 0;
+  for (let i = 0; i < field.length; i++) {
+    const ch = field[i];
+    if (ch === '[') depth++;
+    else if (ch === ']') {
+      if (depth > 0) depth--;
+    } else if (depth === 0 && ch === ' ' && field.startsWith(PYTEST_REPR_SEP, i)) {
+      return field.slice(0, i).trim();
+    }
+  }
+  return field;
+}
