{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amabie-reliability-network.local/schemas/evidence.schema.json",
  "title": "Amabie Evidence Bundle",
  "description": "Machine-readable output of one Amabie experiment. GENERATED FILE — the single source of truth is packages/evidence/schema/src/contract.ts (schema.test.ts regenerates and deep-compares; edit the contract, never this file). The classification field is produced exclusively by the deterministic decision table (docs/PLAN.md section 6); no field in this schema can be authored by an AI provider. Trustful-tier fields (round infraSignal; treeComparison.snapshots/observationAnomalies) are required exactly when classification.label is PASS/CONFIRMED_REGRESSION/PRE_EXISTING_FAILURE — see the allOf block; the runtime validator enforces the same tier and additionally requires the anomaly lists to be EMPTY for a trustful label (a rule beyond JSON-schema presence).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amabieVersion",
    "classification",
    "commands",
    "createdAt",
    "dependency",
    "downstream",
    "environment",
    "experimentId",
    "integrity",
    "rounds",
    "runId",
    "schemaVersion",
    "treeComparison"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "amabieVersion": {
      "type": "string",
      "minLength": 1
    },
    "experimentId": {
      "type": "string",
      "minLength": 1
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineVersion",
        "candidateVersion",
        "package"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "baselineVersion": {
          "type": "string",
          "minLength": 1
        },
        "candidateVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "fetchMethod",
        "repositoryUrl",
        "tarballSha256"
      ],
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fetchMethod": {
          "enum": [
            "tarball-by-sha"
          ]
        },
        "tarballSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "nodeVersion",
        "npmVersion",
        "packageManagerUsed",
        "platform",
        "toolchainOverrides"
      ],
      "properties": {
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "npmVersion": {
          "type": "string",
          "minLength": 1
        },
        "packageManagerUsed": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "toolchainOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "prepare",
        "swap",
        "test"
      ],
      "properties": {
        "prepare": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "build": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "swap": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "test": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "arm",
          "durationMs",
          "envKeys",
          "executionObservation",
          "exitCode",
          "hasRunnerSummary",
          "killedByTimeout",
          "logPath",
          "normalizedStderrSha256",
          "normalizedStdoutSha256",
          "rawStderrSha256",
          "rawStdoutSha256",
          "round",
          "startedAt"
        ],
        "properties": {
          "arm": {
            "enum": [
              "baseline",
              "candidate"
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 1
          },
          "exitCode": {
            "type": "number"
          },
          "killedByTimeout": {
            "type": "boolean"
          },
          "hasRunnerSummary": {
            "type": "boolean"
          },
          "infraSignal": {
            "type": "boolean"
          },
          "reportedPassing": {
            "type": "integer",
            "minimum": 0
          },
          "reportedFailing": {
            "type": "integer",
            "minimum": 0
          },
          "reportedPending": {
            "type": "integer",
            "minimum": 0
          },
          "failingTestNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "crashSignal": {
            "type": "boolean"
          },
          "sweepFailed": {
            "type": "boolean"
          },
          "executionObservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frameCount",
              "framesSha256",
              "observedFailingIdentities",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VALID",
                  "ABSENT",
                  "INVALID"
                ]
              },
              "observedFailingIdentities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "framesSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "frameCount": {
                "type": "integer",
                "minimum": 0
              },
              "observedCounts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "failing",
                  "passing",
                  "pending"
                ],
                "properties": {
                  "passing": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failing": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "expectedMochaVersion": {
                "type": "string",
                "minLength": 1
              },
              "observedMochaVersion": {
                "type": "string",
                "minLength": 1
              },
              "expectedRunnerTreeSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observedRunnerTreeSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "invalidReason": {
                "type": "string",
                "minLength": 1
              },
              "absentKind": {
                "enum": [
                  "not-mocha-bin",
                  "no-injection",
                  "runner-identity-unpinned"
                ]
              },
              "strayFd3Bytes": {
                "type": "boolean"
              },
              "strayFd3Sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "startedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "rawStdoutSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rawStderrSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalizedStdoutSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalizedStderrSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "logPath": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "envKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "treeComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineTreeSha256",
        "candidateTreeSha256",
        "dependencyCopies",
        "driftConfinedToDependency",
        "observationStatus",
        "resolvedVersions"
      ],
      "properties": {
        "baselineTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "driftConfinedToDependency": {
          "type": "boolean"
        },
        "observationStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "enum": [
                "VALID",
                "INCOMPLETE",
                "INVALID"
              ]
            },
            "candidate": {
              "enum": [
                "VALID",
                "INCOMPLETE",
                "INVALID"
              ]
            }
          }
        },
        "resolvedVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "type": "string",
              "minLength": 1
            },
            "candidate": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dependencyCopies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "type": "integer",
              "minimum": 0
            },
            "candidate": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonicalLog",
                "canonicalSha256",
                "rawStderrLog",
                "rawStderrSha256",
                "rawStdoutLog",
                "rawStdoutSha256"
              ],
              "properties": {
                "rawStdoutLog": {
                  "type": "string",
                  "minLength": 1
                },
                "rawStdoutSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rawStderrLog": {
                  "type": "string",
                  "minLength": 1
                },
                "rawStderrSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "canonicalLog": {
                  "type": "string",
                  "minLength": 1
                },
                "canonicalSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "candidate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonicalLog",
                "canonicalSha256",
                "rawStderrLog",
                "rawStderrSha256",
                "rawStdoutLog",
                "rawStdoutSha256"
              ],
              "properties": {
                "rawStdoutLog": {
                  "type": "string",
                  "minLength": 1
                },
                "rawStdoutSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rawStderrLog": {
                  "type": "string",
                  "minLength": 1
                },
                "rawStderrSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "canonicalLog": {
                  "type": "string",
                  "minLength": 1
                },
                "canonicalSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "observationAnomalies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "json"
              ],
              "properties": {
                "json": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "candidate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "json"
              ],
              "properties": {
                "json": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "reason",
        "reproductionCount",
        "rule"
      ],
      "properties": {
        "label": {
          "enum": [
            "PASS",
            "CONFIRMED_REGRESSION",
            "PRE_EXISTING_FAILURE",
            "FLAKY",
            "INFRASTRUCTURE_FAILURE",
            "INCONCLUSIVE"
          ]
        },
        "rule": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reproductionCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestSha256",
        "version"
      ],
      "properties": {
        "version": {
          "type": "number"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachedAt",
        "provider",
        "summary"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "attachedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "label": {
                "enum": [
                  "PASS",
                  "CONFIRMED_REGRESSION",
                  "PRE_EXISTING_FAILURE"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rounds": {
            "items": {
              "required": [
                "infraSignal"
              ]
            }
          },
          "treeComparison": {
            "required": [
              "snapshots",
              "observationAnomalies"
            ]
          }
        }
      }
    }
  ]
}
