{
  "name": "amabie",
  "version": "2.0.0",
  "private": true,
  "description": "Amabie: deterministic verification for software changes with reproducible evidence bundles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/core/*",
    "packages/runner/*",
    "packages/evidence/*",
    "packages/registry-npm",
    "packages/github",
    "packages/ai",
    "packages/support"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:force": "tsc -b --force",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "npm run build:force && node --test --test-concurrency=8 \"packages/**/dist/test/*.test.js\" \"apps/**/dist/test/*.test.js\" \"tooling/**/*.test.mjs\"",
    "verify:productization": "node tooling/verify-productization.mjs",
    "bench": "node tooling/benchmark/bench.mjs",
    "bench:report": "node tooling/benchmark/bench.mjs --from",
    "standalone": "node tooling/standalone.mjs",
    "prove": "node apps/cli/dist/src/main.js prove fixtures/axios-0.27-to-1.0/specs/axios-mock-adapter.json",
    "report": "node apps/cli/dist/src/main.js report"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
